# Configuration & Telemetry Environment Variables
# Puedes sobreescribir cualquiera de estas variables en tu entorno o en GitHub Actions Secrets/Vars

# Objetivo (Usuario u Organización de GitHub)
STATS_TARGET=shellaquiles
STATS_IS_ORG=true

# Título y Branding
STATS_TITLE=stats.shellaquiles.org — Telemetría & Métricas Open Source
STATS_BRAND_PREFIX=shell
STATS_BRAND_MIDDLE=aquiles
STATS_BRAND_SUFFIX=.org
STATS_BRAND_PREFIX_COLOR=#22c55e
STATS_BRAND_SUFFIX_COLOR=#f43f5e
STATS_TAGLINE=ACTIVO DESDE AGOSTO 2025

# Enlaces externos
STATS_GITHUB_URL=https://github.com/shellaquiles
STATS_WEBSITE_URL=https://shellaquiles.org

# Repositorios a excluir (separados por comas)
STATS_EXCLUDE_REPOS=stats

# Ruta opcional a archivo de configuración JSON
STATS_CONFIG_FILE=config.json
